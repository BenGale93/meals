# Copy to .env and adjust. The systemd unit loads it via EnvironmentFile=
# (see deploy/meals.service). .env is gitignored; never commit real secrets.
#
# TARGET location for the database, outside the git checkout. It only takes
# effect once BOTH of these are true:
#   (a) the app reads DATABASE_URL (TODO -> Admin item 3, done), and
#   (b) the file has been moved there (migrate_plan.md, section 4).
# Until then the app keeps using its relative default, i.e.
# /home/galeb/meals/meals.db. So do NOT create this .env on the Pi before you
# are ready to move the database — the app would start against an empty
# database at this path, which looks exactly like data loss.
#
# Four slashes: scheme://<host>/<absolute-path>
DATABASE_URL=sqlite+aiosqlite:////home/galeb/meals-data/meals.db
