# Copy to .env and adjust. The systemd unit loads it via EnvironmentFile=
# (see deploy/meals.service). .env is gitignored; never commit real secrets.
#
# Location of the database, outside the git checkout. The app reads
# DATABASE_URL from this file via systemd's EnvironmentFile= (see
# deploy/meals.service); it falls back to the relative
# sqlite+aiosqlite:///meals.db only when DATABASE_URL is unset.
#
# The Pi was moved to this path on 2026-10-18: /home/galeb/meals-data/meals.db.
# For a fresh install, create the file only once the database actually lives at
# DATABASE_URL — otherwise the app starts against an empty database at this
# path, which looks exactly like data loss.
#
# Four slashes: scheme://<host>/<absolute-path>
DATABASE_URL=sqlite+aiosqlite:////home/galeb/meals-data/meals.db
