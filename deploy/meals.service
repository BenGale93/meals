# meals.service — systemd unit for the self-hosted meals app on the Pi.
#
# Install / update:
#   sudo cp deploy/meals.service /etc/systemd/system/meals.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meals
#
# Configuration (notably DATABASE_URL) is read from /home/galeb/meals/.env via
# EnvironmentFile below — see .env.example and deploy/README.md. The leading "-"
# means the unit still starts if .env does not exist yet.
#
# Schema: Alembic owns it (migrations/), so the app no longer creates tables at
# start-up. ExecStartPre upgrades the schema before every start; the live
# database is stamped at the baseline, so this is safe and a no-op when already
# at head. `just deploy` takes a verified backup before restarting.

[Unit]
Description=Meals Application
After=network.target

[Service]
Type=simple
User=galeb
Group=galeb
WorkingDirectory=/home/galeb/meals
EnvironmentFile=-/home/galeb/meals/.env
Environment=PYTHONUNBUFFERED=1
# Keep date.today() (planner, roast timings) on local time regardless of the host default.
# Set after EnvironmentFile so .env cannot silently change it.
Environment=TZ=Europe/London
# Apply pending migrations before the app starts; a failure aborts the start.
ExecStartPre=/home/galeb/.local/bin/uv run --frozen alembic upgrade head
# --frozen: never re-resolve dependencies at start; sync happens in the deploy step.
ExecStart=/home/galeb/.local/bin/uv run --frozen fastapi run src/main.py
Restart=on-failure
RestartSec=5
SyslogIdentifier=meals
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
